# Modèle de la configuration de la sauvegarde nocturne (sauvegarde.sh,
# ADR 022). À copier en ~/centre-affaires/sauvegarde.env sur le serveur, puis
# `chmod 600` : le script refuse un fichier lisible par d'autres comptes.
# Jamais versionné, jamais copié par la CI. Lu par bash : pas d'espace autour
# du signe égal, et des guillemets autour d'une valeur qui contient des espaces.

# --- Base -------------------------------------------------------------------
# La base est le service `db` du compose du serveur : le script y lance
# `mysqldump` par `docker compose exec`. Utilisateur `sauvegarde`, en lecture
# seule (README, « Sauvegardes ») : jamais `root`, qui n'a rien à faire ici.
MYSQL_DATABASE=centre_affaires
MYSQL_USER=sauvegarde
MYSQL_PWD=

# Dossier du compose et nom du service de la base. SAUVEGARDE_DB_SERVICE=
# (vide) : `mysqldump` installé sur le serveur, qui lit MYSQL_HOST et
# MYSQL_TCP_PORT.
SAUVEGARDE_COMPOSE_DIR=/home/deploy/centre-affaires
SAUVEGARDE_DB_SERVICE=db

# Options ajoutées à mysqldump, séparées par des espaces. Vide par défaut :
# toute la base, avec ses routines, triggers et événements.
# SAUVEGARDE_DUMP_OPTIONS=

# --- Stockage objet à copier ------------------------------------------------
# Bucket `uploads` de la branche `production` : mêmes valeurs que les
# variables AWS_* du .env de l'application.
RCLONE_CONFIG_STOCKAGE_TYPE=s3
RCLONE_CONFIG_STOCKAGE_PROVIDER=Other
RCLONE_CONFIG_STOCKAGE_ENDPOINT=
RCLONE_CONFIG_STOCKAGE_REGION=
RCLONE_CONFIG_STOCKAGE_ACCESS_KEY_ID=
RCLONE_CONFIG_STOCKAGE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_STOCKAGE_FORCE_PATH_STYLE=true
SAUVEGARDE_SOURCE_STOCKAGE=stockage:uploads

# --- Destination, hors du serveur -------------------------------------------
# Un stockage S3 en UE, dans une autre région que le VPS. Exemple : OVHcloud
# Object Storage, région Gravelines. Le bucket est créé à la main, privé.
RCLONE_CONFIG_HORSSITE_TYPE=s3
RCLONE_CONFIG_HORSSITE_PROVIDER=Other
RCLONE_CONFIG_HORSSITE_ENDPOINT=https://s3.gra.io.cloud.ovh.net
RCLONE_CONFIG_HORSSITE_REGION=gra
RCLONE_CONFIG_HORSSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_HORSSITE_SECRET_ACCESS_KEY=
# Le bucket existe déjà : ne pas réclamer le droit de le créer.
RCLONE_CONFIG_HORSSITE_NO_CHECK_BUCKET=true
SAUVEGARDE_DESTINATION=horssite:centre-affaires-sauvegardes

# --- Chiffrement ------------------------------------------------------------
# Clés PUBLIQUES age, une par ligne (`age1…`). Les clés privées ne sont jamais
# sur le serveur (docs/exploitation/plan-de-reprise.md, « Secrets »).
SAUVEGARDE_DESTINATAIRES=/home/deploy/centre-affaires/sauvegarde-destinataires.txt

# Fichiers du serveur joints au lot, chiffrés comme le reste, séparés par des
# espaces. Vide : aucun.
SAUVEGARDE_FICHIERS="/home/deploy/centre-affaires/.env /home/deploy/centre-affaires/sauvegarde.env"

# --- Rétention --------------------------------------------------------------
# Lots gardés : le plus récent de chacun des N derniers jours, semaines et
# mois. Un lot compte pour toutes les périodes qu'il couvre.
SAUVEGARDE_GARDER_QUOTIDIENNES=7
SAUVEGARDE_GARDER_HEBDOMADAIRES=4
SAUVEGARDE_GARDER_MENSUELLES=12

# --- Divers -----------------------------------------------------------------
# Dossier de travail : le lot y est préparé, en clair, puis effacé. Prévoir
# deux fois la taille du stockage objet plus celle de la base.
# SAUVEGARDE_TRAVAIL=/var/tmp

# Facultatif : adresse appelée après chaque passage réussi, suivie de `/fail`
# après un échec (convention de Healthchecks.io ; un service auto-hébergé
# convient). Elle signale aussi une sauvegarde qui ne tourne plus du tout.
# SAUVEGARDE_SIGNAL_URL=
