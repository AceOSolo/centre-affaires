# Modèle du `.env` de production, à poser dans /home/deploy/centre-affaires/
# sur le VPS (`chmod 600`). Il ne quitte jamais le serveur : ni dépôt, ni CI
# (infra/serveur/README.md, section 3). Lu par compose.yml pour les services
# `db`, `app` et `migrer`.
#
# Les variables communes avec le développement sont commentées dans le
# `.env.example` de la racine ; seules les valeurs de production sont notées
# ici.

# --- Base MySQL 8 (service `db` de compose.yml) -----------------------------
# Dans le compose, `app` et `migrer` forcent DB_HOST=db : la valeur ci-dessous
# ne sert qu'aux commandes lancées à la main hors conteneur.
DB_HOST=db
DB_PORT=3306
DB_NAME=centre_affaires
# Utilisateur de l'application : DML et EXECUTE seulement. Créé et mis à jour
# par `docker compose run --rm migrer`. `openssl rand -base64 24`.
DB_USER=centre_affaires
DB_PASSWORD=
# Administrateur de la base : mot de passe de `root`, fixé au premier démarrage
# du volume `db-data`. Sert aux migrations et à la sauvegarde. Différent de
# DB_PASSWORD. `openssl rand -base64 24`.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
# Entre deux conteneurs d'un même hôte : pas de TLS.
DB_SSL=false

# --- Application ------------------------------------------------------------
# `openssl rand -base64 32`. Changer cette valeur ferme toutes les sessions.
AUTH_SECRET=
APP_URL=https://www.handfield.fr
# Ne jamais mettre `true` en production : l'application refuse de démarrer.
AUTH_SKIP_EMAIL_VERIFICATION=false
# Port local de l'application, 3100 par défaut (3000 est pris par Open WebUI
# sur le serveur, ADR 051). À changer seulement si 3100 l'est aussi, et à
# reporter alors dans `nginx-handfield-https.conf`.
# PORT_LOCAL=3100

# --- Stockage de fichiers (S3, région UE) -----------------------------------
# MinIO sur le VPS ou un S3 d'un hébergeur européen. S3_REGION figure dans la
# liste des régions de l'Union (src/lib/stockage.ts).
S3_ENDPOINT=
S3_REGION=eu-west-3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=uploads
S3_FORCE_PATH_STYLE=true

# --- Secrets propres à la production ----------------------------------------
# `openssl rand -base64 32` chacun. À copier hors du serveur (README,
# « Chiffrement des documents » ; plan de reprise, « Secrets »). Perdre
# DOCUMENTS_ENCRYPTION_KEY, c'est perdre les documents.
DOCUMENTS_ENCRYPTION_KEY=
DOCUMENTS_ENCRYPTION_KEY_VERSION=1
SECRETS_ENCRYPTION_KEY=
MAINTENANCE_TOKEN=
# API de Dolibarr, devis (ADR 043) et produits par webhook (ADR 049) : valeur aléatoire, remise au développeur Dolibarr.
DOLIBARR_API_TOKEN=

# --- Google Agenda ----------------------------------------------------------
# URI de redirection : APP_URL + /ressources/agendas/retour
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Courriels (Brevo, ADR 015) ---------------------------------------------
# SMTP_USER : identifiant affiché par Brevo ; SMTP_PASSWORD : la clé SMTP, pas
# la clé d'API (infra/serveur/README.md, étape 8).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
