# Modèle du fichier `.env` du serveur, à créer dans ~/centre-affaires/ puis
# `chmod 600 .env`. Jamais versionné, jamais copié par la CI.

# Rôle applicatif `app_centre` sur la branche Neon `production` (ADR 003),
# tel qu'imprimé par `node infra/provision-role-applicatif.mjs`.
# Jamais DATABASE_URL : le rôle propriétaire contourne la RLS et n'a rien à
# faire sur le serveur.
APP_DATABASE_URL=

# Neon Auth de la branche `production` (`neon env pull` sur cette branche).
NEON_AUTH_BASE_URL=
# 32 octets : `openssl rand -base64 32`. Propre à la production.
NEON_AUTH_COOKIE_SECRET=

# Port local de l'application, si 3000 est déjà pris par un autre service du
# serveur. Reporter la même valeur dans la configuration Apache.
# PORT_LOCAL=3000

# Adresse publique de l'application, sans barre finale. Sert aux liens
# absolus, dont le retour de Google Agenda.
APP_URL=

# Stockage de fichiers (courrier, photos). Écrites par `neon env pull` en
# développement, à renseigner à la main ici.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Google Agenda (ADR 014) : client OAuth du projet Google Cloud de production,
# URI de redirection APP_URL + /ressources/agendas/retour.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 octets : `openssl rand -base64 32`. Propre à la production, jamais
# réutilisée ailleurs. La perdre oblige à reconnecter l'agenda.
SECRETS_ENCRYPTION_KEY=

# Courriels (ADR 015), envoyés par Brevo : Brevo → SMTP & API → onglet SMTP.
# La clé SMTP n'est pas la clé d'API. Sans ces valeurs, l'application
# fonctionne mais ne prévient personne.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Domaine authentifié dans Brevo (README, « Courriels avec Brevo »).
MAIL_FROM="Handfield <no-reply@handfield.fr>"

# Purge nocturne du courrier échu (README, « Conservation du courrier »).
# `openssl rand -base64 32`.
MAINTENANCE_TOKEN=
