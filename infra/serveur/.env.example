# Modèle du fichier `.env` du serveur, à créer dans ~/centre-affaires/ puis
# `chmod 600 .env`. Jamais versionné, jamais copié par la CI.

# Adresse canonique du site, et celle qui y renvoie.
DOMAINE=www.handfield.fr
DOMAINE_SECONDAIRE=handfield.fr

# Rôle applicatif `app_centre` sur la branche Neon `production` (ADR 003),
# tel qu'imprimé par `node infra/provision-role-applicatif.mjs`.
# Jamais DATABASE_URL : le rôle propriétaire contourne la RLS et n'a rien à
# faire sur le serveur.
APP_DATABASE_URL=

# Neon Auth de la branche `production` (`neon env pull` sur cette branche).
NEON_AUTH_BASE_URL=
# 32 octets : `openssl rand -base64 32`. Propre à la production.
NEON_AUTH_COOKIE_SECRET=
