# Copier en .env.local (développement) ou .env (serveur). Jamais versionné.
# Chargé par `npm run db:migrer`, et par Next.js pour l'application.

# --- Base MySQL 8 -----------------------------------------------------------
# En développement : le service `db` de docker-compose.yml (`docker compose up
# -d db`). En production : le service `db` de infra/serveur/compose.yml, où
# DB_HOST vaut `db` (voir infra/serveur/.env.example).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=centre_affaires
# Utilisateur de l'application : lecture et écriture seulement, jamais de
# droit de définition. Créé par `npm run db:migrer`, qui lui donne ses droits.
DB_USER=centre_affaires
DB_PASSWORD=
# Administrateur : migrations et outillage uniquement (`npm run db:migrer`).
# Il crée la base et l'utilisateur applicatif. Ne jamais s'en servir pour les
# requêtes de l'application. En local avec docker-compose.yml : root.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
# true : connexion TLS avec vérification du certificat. Inutile entre deux
# conteneurs du même compose ; à activer pour une base distante.
DB_SSL=false

# --- Authentification (Better Auth, sur la même base) -----------------------
# Signe les sessions et les jetons. 32 octets : `openssl rand -base64 32`.
# Jamais versionné, différent par environnement.
AUTH_SECRET=
APP_URL=http://localhost:3000
# Développement UNIQUEMENT : ne pas exiger la vérification de l'adresse
# électronique (aucun courriel ne part d'un poste de dev). L'application
# refuse de démarrer avec cette valeur en production.
AUTH_SKIP_EMAIL_VERIFICATION=false

# --- Stockage de fichiers (courrier, photos) --------------------------------
# Un S3 quelconque en région de l'Union européenne : MinIO (profil `stockage`
# de docker-compose.yml, ou sur le VPS), OVHcloud, Scaleway… S3_REGION doit
# être une région de l'UE : sinon le stockage refuse de fonctionner (R33,
# src/lib/stockage.ts).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-west-3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=uploads
# true pour MinIO et la plupart des S3 auto-hébergés (adressage par chemin).
S3_FORCE_PATH_STYLE=true

# Chiffrement au repos des documents déposés dans le stockage (scans de
# courrier, photos d'enveloppe — R22, ADR 020). Sans clé, aucun document n'est
# déposé : jamais de dépôt en clair. 32 octets : `openssl rand -base64 32`.
# Propre à chaque environnement, jamais celle de la production : une copie de
# la production n'en lit pas les documents.
DOCUMENTS_ENCRYPTION_KEY=
# Numéro de la clé courante, inscrit sur chaque objet chiffré. 1 pour la
# première clé ; une rotation passe à 2 et garde l'ancienne sous
# DOCUMENTS_ENCRYPTION_KEY_1 le temps de la reprise
# (infra/serveur/README.md, « Chiffrement des documents »).
DOCUMENTS_ENCRYPTION_KEY_VERSION=1

# Google Agenda : un agenda par ressource (ADR 014, section « Mise en
# place »). Sans ces valeurs, l'intégration est simplement proposée comme non
# configurée. URI de redirection à déclarer chez Google :
#   APP_URL + /ressources/agendas/retour
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chiffre les jetons confiés par des tiers avant leur entrée en base.
# 32 octets : `openssl rand -base64 32`. Différente par environnement : une
# copie de la production ne doit pas pouvoir lire ses jetons.
SECRETS_ENCRYPTION_KEY=

# Courriels de l'application, envoyés par Brevo (arrivée d'un courrier,
# numérisation, invitation à l'espace client — ADR 015). Laisser vide en
# développement : sans ces valeurs rien ne part, et aucune adresse réelle ne
# doit recevoir de message depuis un poste de dev.
# Brevo → SMTP & API → onglet SMTP : serveur, port, identifiant, clé SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'un domaine authentifié dans Brevo (infra/serveur/README.md).
MAIL_FROM=

# Jeton de la purge nocturne du courrier échu (POST /api/maintenance/conservation).
# `openssl rand -base64 32`. Sans lui, la route n'existe pas.
MAINTENANCE_TOKEN=

# Jeton de l'API de Dolibarr : devis (GET /api/dolibarr/devis, ADR 043,
# docs/integrations/dolibarr.md) et produits reçus par webhook
# (POST /api/dolibarr/produits, ADR 049). `openssl rand -base64 32`, à remettre
# au développeur Dolibarr. Sans lui, l'API n'existe pas.
DOLIBARR_API_TOKEN=
