# Copier en .env.local. Sur Neon, `neon link` / `neon checkout <branche>`
# remplissent DATABASE_URL et les variables NEON_*/AWS_* automatiquement :
# ne pas les saisir a la main, elles sont reecrites a chaque checkout.

# Proprietaire de la base : migrations et outillage uniquement.
# Ce role contourne la Row Level Security (BYPASSRLS sur Neon, superutilisateur
# en local), il ne doit jamais servir aux requetes de l'application.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/centre_affaires

# Role applicatif, sans BYPASSRLS : la seule identite sous laquelle les
# politiques d'isolation par centre s'appliquent reellement.
# Genere par : node infra/provision-role-applicatif.mjs
APP_DATABASE_URL=

AUTH_SECRET=
APP_URL=http://localhost:3000

# Authentification : Neon Auth (Better Auth managé, schéma `neon_auth`).
# BASE_URL et JWKS_URL sont écrits par `neon env pull`.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Chiffre les cookies de session mis en cache par l'application. 32 octets :
# `openssl rand -base64 32`. Jamais versionné, différent par environnement.
NEON_AUTH_COOKIE_SECRET=

# Stockage de fichiers (courrier, photos) : AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3 et AWS_REGION sont écrites par
# `neon env pull`. En production (VPS), les renseigner à la main.

# Google Agenda : un agenda par ressource (ADR 014, section « Mise en
# place »). Sans ces valeurs, l'intégration est simplement proposée comme non
# configurée. URI de redirection à déclarer chez Google :
#   APP_URL + /ressources/agendas/retour
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chiffre les jetons confiés par des tiers avant leur entrée en base.
# 32 octets : `openssl rand -base64 32`. Différente par environnement : une
# branche copiée depuis la production ne doit pas pouvoir lire ses jetons.
SECRETS_ENCRYPTION_KEY=

# Courriels de l'application, envoyés par Brevo (arrivée d'un courrier,
# numérisation, invitation à l'espace client — ADR 015). Laisser vide en
# développement : sans ces valeurs rien ne part, et aucune adresse réelle ne
# doit recevoir de message depuis un poste de dev.
# Brevo → SMTP & API → onglet SMTP : serveur, port, identifiant, clé SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'un domaine authentifié dans Brevo (infra/serveur/README.md).
MAIL_FROM=

# Jeton de la purge nocturne du courrier échu (POST /api/maintenance/conservation).
# `openssl rand -base64 32`. Sans lui, la route n'existe pas.
MAINTENANCE_TOKEN=
